# LLM providers
GOOGLE_API_KEY=
GROQ_API_KEY=

# Search tool
TAVILY_API_KEY=

# Checkpointer (Postgres persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security (recommended, no downside to enabling)
LANGGRAPH_STRICT_MSGPACK=true

# Tracing (optional — only needed together)
LANGSMITH_API_KEY=your_key_here
LANGSMITH_TRACING=true
