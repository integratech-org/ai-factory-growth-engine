# LLM providers
GOOGLE_MODEL_NAME=
GOOGLE_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=

# Search tool
TAVILY_API_KEY=

# SEC EDGAR (required identity string per SEC compliance — use your real name/email)
SEC_EDGAR_NAME=
SEC_EDGAR_EMAIL=

# Checkpointer (Postgres persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security (recommended, no downside to enabling)
LANGGRAPH_STRICT_MSGPACK=true

# Tracing (optional — only needed together)
LANGSMITH_API_KEY=your_key_here
LANGSMITH_TRACING=true
